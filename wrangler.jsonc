{
  // Site institucional da Maruvas: Worker só com arquivos estáticos (pasta public/).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grupomaruvas",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "keep_vars": true
}
